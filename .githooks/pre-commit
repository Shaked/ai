#!/bin/sh
set -eu

if git diff --cached --quiet -- skills/ evals/ .githooks/; then
    exit 0
fi

snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM

git checkout-index --all --prefix="$snapshot/"
python3 "$snapshot/evals/run.py" --output "$(git rev-parse --show-toplevel)/results.json"
